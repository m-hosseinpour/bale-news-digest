# سقف‌های ایمنی جمع‌آوری
MAX_PAGES_PER_RUN=50
MAX_POSTS_PER_RUN=500
HISTORY_PAGE_SLEEP=0.3
HTTP_TIMEOUT=30

BALE_BOT_CHAT_ID=

# (اختیاری) chat_id اختصاصی برای هر دستهٔ مهم. در صورت تنظیم،
# خلاصهٔ همان دسته علاوه بر کانال اصلی، به این کانال هم ارسال می‌شود.
# اگر خالی باشد، آن دسته فقط در کانال اصلی ارسال می‌شود.
# نام‌های قابل استفاده: WAR_CONFLICT, POLITICS, ECONOMY, SCIENCE_TECH
# BALE_BOT_CHAT_ID_WAR_CONFLICT=
# BALE_BOT_CHAT_ID_POLITICS=
# BALE_BOT_CHAT_ID_ECONOMY=
# BALE_BOT_CHAT_ID_SCIENCE_TECH=

