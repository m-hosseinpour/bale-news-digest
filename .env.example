CHANNEL_URL=https://ble.ir/s/akharinkhabar
MAX_SCROLLS=500
SCROLL_PAUSE=2

BALE_BOT_CHAT_ID=

# (اختیاری) chat_id اختصاصی برای هر دستهٔ مهم. در صورت تنظیم،
# خلاصهٔ batch همان دسته علاوه بر کانال اصلی، به این کانال هم ارسال می‌شود.
# اگر خالی باشد، آن دسته فقط در کانال اصلی ارسال می‌شود.
# نام‌های قابل استفاده: WAR_CONFLICT, POLITICS, ECONOMY, SCIENCE_TECH
# BALE_BOT_CHAT_ID_WAR_CONFLICT=
# BALE_BOT_CHAT_ID_POLITICS=
# BALE_BOT_CHAT_ID_ECONOMY=
# BALE_BOT_CHAT_ID_SCIENCE_TECH=

BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=https://bot.m-hosseinpour.ir/webhook/news-bot

OPEN_AI_MODEL_NAME=deepseek-v4-flash
OPEN_AI_BASE_URL=https://api.avalai.ir/v1
OPEN_AI_API_KEY=

# Playwright / Chromium
# مقادیر timeout بر حسب ثانیه
HEADLESS=true
DISABLE_IMAGES=true
PAGE_LOAD_TIMEOUT=45
WEBDRIVER_WAIT_TIMEOUT=20

# بعد از چند fetch، Chromium restart شود
# اگر RAM کم است، مثلاً 5 بگذار
# اگر نمی‌خواهی restart شود، 0 بگذار
MAX_DRIVER_REUSE=20

# (اختیاری) مسیر Chromium محلی. اگر خالی باشد و مسیر پیش‌فرض
# ~/.cache/playwright-chromium/chromium موجود باشد، خودکار برداشته می‌شود.
# این مسیر را install_chromium.py می‌سازد.
# CHROMIUM_EXECUTABLE_PATH=
